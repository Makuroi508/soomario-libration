# Soomario Libration — environment template
# Copy to .env for local runs (and add .env to .gitignore — never commit real keys).
# On Railway, set these as service variables instead of shipping a file.
# Every var here has a sane default in config.py; only the credentials are required.

# ─── Hyperliquid credentials (REQUIRED for live/dry-run; unused in pure paper) ───
HL_ACCOUNT_ADDRESS=0xYourAccountOrVaultAddress
HL_PRIVATE_KEY=0xYourApiWalletPrivateKey      # API wallet key — never commit
HL_IS_VAULT=0                                 # 1 if trading a vault

# ─── Run mode ───────────────────────────────────────────────────
# Launch in PAPER. Watch a few real 4h bars populate the dashboard, then go live.
PAPER=1                # 1 = simulate fills vs live prices, never send orders
DRY_RUN=0              # 1 = read live, orders are no-ops (quick loop check only)
ENTRIES_ENABLED=1      # 0 = manage existing positions but open no new ones
TRAIL_ENABLED=1        # 0 = hard stop only, no trailing

# ─── State / deploy ─────────────────────────────────────────────
STATE_PATH=./state     # ON RAILWAY: set to /data and mount a volume there
# DB_PATH=             # defaults to <STATE_PATH>/libration.db
PORT=8080              # public networking port must match this
LOG_LEVEL=INFO

# ─── Strategy (FROZEN — walk-forward validated; leave at defaults) ──
RSI_LEN=14
RSI_TF=4h
LONG_LEVEL=50          # crossover up  -> long
SHORT_LEVEL=40         # crossunder down -> short
TRAIL_PCT=0.55         # arms at +0.55%, trails 0.55% behind peak
HARD_STOP_PCT=10       # native resting trigger, never moved against
DAILY_DD_PCT=5         # halt new entries once down 5% on the UTC day

# ─── Sizing / leverage (launch at 2x → 10 concurrent) ───────────
LEVERAGE=2
NOTIONAL_FRAC=0.20     # 20% notional per position; max_concurrent = LEVERAGE/NOTIONAL_FRAC

# ─── Universe (volatile alt perps; main DEX only) ───────────────
# The Elite book (soomario-elite config grid, 2026-08-16): 330 runs at 1m on
# real data at the measured fee rate, winners filtered by split-half stability
# and plateau behaviour. Seven originals carry live-fill corroboration; the
# four fast-arming additions (JTO, PENGU, XMR, and FARTCOIN's new config) do
# not yet -- run those at reduced size or PAPER for a probation period.
# Dropped -- negative in ALL 15 grid combos each: NEAR, WLD, DOT, TAO, ZEC,
# ENA, ATOM, AAVE. Failed split-half stability: ADA, BCH. Also out: AVAX
# (negative all of 2026), CRV (negative at every setting at tick resolution).
COINS=HYPE,CC,SOL,ONDO,kPEPE,SUI,LINK,FARTCOIN,JTO,PENGU,XMR

# Per-coin overrides (JSON). Anything not named inherits the frozen set.
# The in-code default already carries the full eleven-coin grid result -- set
# this only to change it. Keys: long_level, short_level, trail_pct,
# hard_stop_pct, arm_delay_min (trail arming delay in minutes; the live
# equivalent of the TradingView chart timeframe).
# COIN_PARAMS={"CC": {"short_level": 65, "trail_pct": 0.20, "hard_stop_pct": 10.5},
#              "KPEPE": {"trail_pct": 0.40}, "SUI": {"trail_pct": 1.00},
#              "LINK": {"trail_pct": 0.75},
#              "FARTCOIN": {"trail_pct": 0.75, "arm_delay_min": 30},
#              "JTO": {"trail_pct": 0.75, "arm_delay_min": 30},
#              "PENGU": {"trail_pct": 1.00, "arm_delay_min": 30},
#              "XMR": {"trail_pct": 1.00, "arm_delay_min": 30}}

# WATCH: fragile / unproven names that trade live at REDUCED size so a wrong call
# costs less. They're added to the traded universe but sized at WATCH_SIZE_MULT.
# Promote a coin to COINS (full size) once live fills confirm the edge holds.
WATCH=
WATCH_SIZE_MULT=0.5

# ─── Timing ─────────────────────────────────────────────────────
POLL_SECONDS=120
RECONCILE_INTERVAL_SEC=300
CANDLE_LIMIT=200       # 4h candles pulled per coin for RSI

# ─── Paper accounting (only used when PAPER=1) ──────────────────
PAPER_START_EQUITY=1000
PAPER_SLIPPAGE_PCT=0.0 # adverse fill padding; set >0 to model friction in paper

# ─── Shadow trail A/B (counterfactual; never trades) ────────────
SHADOW_TRAILS=0.3,0.4
MEASURED_FRICTION_PCT=0.5   # placeholder; replaced by measured value after ~5 live fills

# ─── Universe filter (universe.py) ──────────────────────────────
MIN_ATR_PCT=3.0
MIN_DAILY_VOL_USD=10000000
UNIVERSE_AUTOFILTER=0  # 0 = report only (never silently drops a validated coin)

# ─── Telegram alerts (optional; no-ops if unset) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════════════════════════════
# FOXIFY / KITSUNE TARGET  (EXCHANGE=foxify)
# Third Railway service, own volume. Leave every line below unset
# on the Hyperliquid and Propr services.
# ═══════════════════════════════════════════════════════════════
# EXCHANGE=foxify
# FOXIFY_API_BASE=https://kitsunedev.foxify.trade/api
# FOXIFY_SIGNAL_ID=soom2
# FOXIFY_PASSPHRASE=              # never commit
# FOXIFY_LEVERAGE=2               # 10 x 15% = 1.5x gross; 2 leaves headroom
# FOXIFY_MAX_DD_PCT=20            # Spark tier, static from initial balance
# FOXIFY_MIN_NOTIONAL=10
# FOXIFY_EQUITY_ADD_UPNL=0        # see equity_breakdown() — verify on day 1

# Sizing: 10 concurrent x 15% x 10% stop = 15% worst-case cluster,
# inside the 20% static floor with room to spare.
# NOTIONAL_FRAC=0.15
# MAX_CONCURRENT=10
# HARD_STOP_PCT=10
# TRAIL_PCT=0.55

# Guard: self-imposed static floor inside Foxify's 20% wall. Breaching
# theirs is terminal and takes the collateral, so stop short of it.
# MAX_DD_PCT=17
# DD_TYPE=static
# DAILY_DD_PCT=5                  # self-imposed; Foxify has no daily rule
# DD_GUARD_MARGIN=1.5

# Universe: live list minus ATOM (not on Orderly, and already failing
# the $2M volume screen on HL — so this costs nothing).
# COINS=DOT,WLD,LINK,TAO,JTO,HYPE,kPEPE,SUI,SOL,NEAR,ADA,ENA,BCH,AVAX,ZEC,ONDO,XMR,AAVE,FARTCOIN,PENGU
# WATCH=AAVE,FARTCOIN,ONDO,PENGU,XMR
# WATCH_SIZE_MULT=0.5

# NOT 120. The trail has no exchange-side order on Kitsune, so this poll
# IS the trail. A 5%-ATR alt clears the 0.55% band inside two minutes.
# POLL_SECONDS=45

# ---- Log volume ----
# At POLL_SECONDS=45 an unthrottled tick heartbeat is ~1900 lines/day, which
# buries entries, exits and guard trips. The line is emitted when the open
# count changes, when equity moves by TICK_LOG_EQ_DELTA, or every
# TICK_LOG_EVERY_SEC as a liveness heartbeat.
# TICK_LOG_EVERY_SEC=600
# TICK_LOG_EQ_DELTA=0.25

# ─── Reporting ───────────────────────────────────────────────────
# /api/report serves full account financials (Reports tab in the dashboard).
# Leave empty and the endpoint is open to anyone who can reach the dashboard;
# set a value and every request must carry ?token= or an X-Report-Token header.
REPORT_TOKEN=
# ═══════════════════════════════════════════════════════════════
# SOLANA VENUES (Pacifica live / Bulk when mainnet opens)
# Separate Railway service from the same repo. Start command:
#     python app_solana.py
# One RSI signal is computed ONCE per tick from Hyperliquid candles and fanned
# to every enabled venue; each venue keeps its own DB, sizing and equity curve
# under STATE_PATH/<venue>/. Strategy params, the eleven-coin book, per-coin
# COIN_PARAMS and the trail arming delay all apply unchanged. Coins a venue
# does not list are dropped automatically at boot (validated against live
# market_info) -- e.g. Pacifica currently lists 8 of the 11 book coins
# (no CC / ONDO / JTO as of 2026-08-16).
# ═══════════════════════════════════════════════════════════════
# ENABLED_VENUES=pacifica            # add ",bulk" when BULK mainnet starts
# PACIFICA_ACCOUNT_ADDRESS=
# PACIFICA_PRIVATE_KEY=              # never commit
# PACIFICA_AGENT=1
# BULK_ACCOUNT_ADDRESS=
# BULK_PRIVATE_KEY=                  # never commit
# STATE_PATH=/data                   # volume required, one per service

# ═══════════════════════════════════════════════════════════════
# FLEET DASHBOARD (one page over every deployment)
# Its own tiny Railway service from this repo. Start command:
#     python app_fleet.py
# Read-only: polls each book's existing /api endpoints server-side and
# renders one combined view. A book that stops answering shows DOWN and a
# wedged worker shows STALE -- a silent failure must never look like a
# quiet market. Solana fan-out sources are expanded per venue via
# /api/venues automatically. No volume, no keys, no state.
# ═══════════════════════════════════════════════════════════════
# FLEET_SOURCES="HL Vault=https://...;Propr 10k=https://...;Propr 5k=https://...;Solana=https://..."
# FLEET_POLL_SEC=30
# FLEET_STALE_SEC=600

