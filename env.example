# Soomario Libration — environment template
# Copy to .env for local runs (and add .env to .gitignore — never commit real keys).
# On Railway, set these as service variables instead of shipping a file.
# Every var here has a sane default in config.py; only the credentials are required.

# ─── Hyperliquid credentials (REQUIRED for live/dry-run; unused in pure paper) ───
HL_ACCOUNT_ADDRESS=0xYourAccountOrVaultAddress
HL_PRIVATE_KEY=0xYourApiWalletPrivateKey      # API wallet key — never commit
HL_IS_VAULT=0                                 # 1 if trading a vault

# ─── Run mode ───────────────────────────────────────────────────
# Launch in PAPER. Watch a few real 4h bars populate the dashboard, then go live.
PAPER=1                # 1 = simulate fills vs live prices, never send orders
DRY_RUN=0              # 1 = read live, orders are no-ops (quick loop check only)
ENTRIES_ENABLED=1      # 0 = manage existing positions but open no new ones
TRAIL_ENABLED=1        # 0 = hard stop only, no trailing

# ─── State / deploy ─────────────────────────────────────────────
STATE_PATH=./state     # ON RAILWAY: set to /data and mount a volume there
# DB_PATH=             # defaults to <STATE_PATH>/libration.db
PORT=8080              # public networking port must match this
LOG_LEVEL=INFO

# ─── Strategy (FROZEN — walk-forward validated; leave at defaults) ──
RSI_LEN=14
RSI_TF=4h
LONG_LEVEL=50          # crossover up  -> long
SHORT_LEVEL=40         # crossunder down -> short
TRAIL_PCT=0.55         # arms at +0.55%, trails 0.55% behind peak
HARD_STOP_PCT=10       # native resting trigger, never moved against
DAILY_DD_PCT=5         # halt new entries once down 5% on the UTC day

# ─── Sizing / leverage (launch at 2x → 10 concurrent) ───────────
LEVERAGE=2
NOTIONAL_FRAC=0.20     # 20% notional per position; max_concurrent = LEVERAGE/NOTIONAL_FRAC

# ─── Universe (volatile alt perps; main DEX only) ───────────────
COINS=DOT,WLD,LINK,TAO,JTO,HYPE,kPEPE,SUI,SOL,NEAR,ADA,ENA,BCH,AVAX,ZEC

# WATCH: fragile / unproven names that trade live at REDUCED size so a wrong call
# costs less. They're added to the traded universe but sized at WATCH_SIZE_MULT.
# Promote a coin to COINS (full size) once live fills confirm the edge holds.
WATCH=
WATCH_SIZE_MULT=0.5

# ─── Timing ─────────────────────────────────────────────────────
POLL_SECONDS=120
RECONCILE_INTERVAL_SEC=300
CANDLE_LIMIT=200       # 4h candles pulled per coin for RSI

# ─── Paper accounting (only used when PAPER=1) ──────────────────
PAPER_START_EQUITY=1000
PAPER_SLIPPAGE_PCT=0.0 # adverse fill padding; set >0 to model friction in paper

# ─── Shadow trail A/B (counterfactual; never trades) ────────────
SHADOW_TRAILS=0.3,0.4
MEASURED_FRICTION_PCT=0.5   # placeholder; replaced by measured value after ~5 live fills

# ─── Universe filter (universe.py) ──────────────────────────────
MIN_ATR_PCT=3.0
MIN_DAILY_VOL_USD=10000000
UNIVERSE_AUTOFILTER=0  # 0 = report only (never silently drops a validated coin)

# ─── Telegram alerts (optional; no-ops if unset) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
